#include <OttoI2R.h>

// 엉덩이(YR 0도, YL 180도)를 끝까지 움직인 뒤, 제자리에서 왼쪽으로 계속 돈다.
// 왼발은 뒤로, 오른발은 앞으로 멈추지 않고 굴린다.
// 동작은 OttoI2R 라이브러리의 rollingLeft()에 들어 있다.
// 보정값은 웹의 [로봇 맞추기]에서 맞춰 보드에 저장한 값을 쓴다.
// 아직 저장하지 않은 보드는 기본값으로 움직인다. 로봇에 따라 안 맞을 수 있으니 먼저 [로봇 맞추기]를 하세요.

void setup() {
  ottoInit();
}

void loop() {
  rollingLeft();
}
