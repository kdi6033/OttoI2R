#include <OttoI2R.h>

// 왼쪽으로 돌며 걷기: 오른발은 YR만 반대 방향으로 기울여 내딛고, 왼발은 다리를 90도에 둔 채 반시계 방향으로 짧게 굴린다.
// 동작은 OttoI2R 라이브러리의 walkLeft()에 들어 있다.
// 보정값은 웹의 [로봇 맞추기]에서 맞춰 보드에 저장한 값을 쓴다.
// 아직 저장하지 않은 보드는 기본값으로 움직인다. 로봇에 따라 안 맞을 수 있으니 먼저 [로봇 맞추기]를 하세요.

void setup() {
  ottoInit();
}

void loop() {
  walkLeft();
}
